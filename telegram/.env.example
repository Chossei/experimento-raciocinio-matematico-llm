# Configuração do Bot do Telegram
# 1. Pegue o token com o @BotFather no Telegram
# 2. Renomeie este arquivo para .env ou adicione a linha abaixo no chave.env da raiz
TELEGRAM_BOT_TOKEN=seu_token_aqui_gerado_pelo_botfather

# O TELEGRAM_CHAT_ID será preenchido automaticamente na primeira vez que você der /start no Telegram
TELEGRAM_CHAT_ID=
